source "https://rubygems.org"

# For local previews only. GitHub Pages builds the live site with its own
# Jekyll 3.9, whose pinned Liquid version crashes on Ruby 3.2 and newer.
# This site uses nothing that renders differently between the two.
gem "jekyll", "~> 4.4"
gem "kramdown-parser-gfm"
gem "webrick"

# Removed from Ruby's default gems in 3.4+
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
